# ============================================================
# CodeQuest — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!

# ---- Backend (set these on Render) ----

# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET=your-strong-random-secret-change-this

# The URL of your deployed frontend (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# ---- Frontend (set these on Vercel) ----

# The URL of your deployed backend API
VITE_API_URL=https://your-app.onrender.com/api
